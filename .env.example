# =========================================================================
# MAGIC PORTFOLIO ENTERPRISE SAAS - MASTER ENVIRONMENT VARIABLES TEMPLATE
# =========================================================================
# Salin file ini menjadi ".env" di root folder monorepo Anda untuk
# mengaktifkan konektivitas antara Frontend, Backend, dan Database.

# -------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma & NestJS)
# -------------------------------------------------------------------------
# Ganti dengan koneksi PostgreSQL Anda (Supabase, Neon, atau Docker Lokal)
# Contoh Supabase: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://saas_admin:saas_password_prod@localhost:5432/saas_production?schema=public"

# -------------------------------------------------------------------------
# 2. CACHE & QUEUE CONFIGURATION (Upstash Redis / Redis Lokal)
# -------------------------------------------------------------------------
# Jika menggunakan Redis lokal (Docker): host="localhost", port=6379, password kosong
# Jika menggunakan Upstash: gunakan host, port, dan password dari console Upstash
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# -------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# -------------------------------------------------------------------------
# Buat string acak minimal 32 karakter untuk JWT_SECRET
# Anda bisa membuatnya via terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="ganti_dengan_kode_rahasia_jwt_anda_minimal_32_karakter"

# -------------------------------------------------------------------------
# 4. PAYMENT GATEWAY CONFIGURATION (Xendit Indonesia)
# -------------------------------------------------------------------------
# XENDIT_SECRET_KEY: Ambil dari Dashboard Xendit -> Settings -> API Keys (mode Test)
# XENDIT_CALLBACK_TOKEN: Ambil dari Dashboard Xendit -> Settings -> Callbacks -> Verification Token
XENDIT_SECRET_KEY="xnd_development_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
XENDIT_CALLBACK_TOKEN="your_xendit_callback_verification_token_here"

# -------------------------------------------------------------------------
# 5. NETWORKING & PORTS
# -------------------------------------------------------------------------
PORT=4000
NODE_ENV="development"

# -------------------------------------------------------------------------
# 6. FRONTEND NEXT.JS CONFIGURATIONS (Prefix NEXT_PUBLIC_)
# -------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000/notifications"

# Password lama portfolio untuk proteksi halaman (tetap dipertahankan untuk kompatibilitas)
PAGE_ACCESS_PASSWORD="Roysubagya9009"
