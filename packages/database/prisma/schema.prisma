datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. Authentication Modules
// ==========================================

model User {
  id            String               @id @default(uuid())
  email         String               @unique
  passwordHash  String?
  name          String?
  avatarUrl     String?
  role          SystemRole           @default(USER)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?            // Soft delete support

  // Relations
  sessions      Session[]
  accounts      Account[]
  memberships   OrganizationMember[]
  orders        Order[]
  posts         Post[]               // Author reference
  activityLogs  ActivityLog[]
  auditLogs     AuditLog[]
  paymentMethods PaymentMethod[]
}

enum SystemRole {
  SUPER_ADMIN
  USER
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// 2. SaaS Core (Multi-Tenant System)
// ==========================================

model Organization {
  id           String               @id @default(uuid())
  name         String
  slug         String               @unique
  stripeId     String?              @unique
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  members      OrganizationMember[]
  workspaces   Workspace[]
  subscription Subscription?
  invoices     Invoice[]
  billingEvents BillingEvent[]

  @@index([slug])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           TenantRole   @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
  BILLING
}

model Workspace {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts          Post[]
  projects       Project[]
  products       Product[]
  settings       Setting[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Subscription {
  id             String       @id @default(uuid())
  organizationId String       @unique
  planId         String
  status         SubStatus
  priceId        String
  quantity       Int          @default(1)
  cancelAtPeriodEnd Boolean   @default(false)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan         @relation(fields: [planId], references: [id])
  usages         SubscriptionUsage[]
  invoices       Invoice[]

  @@index([organizationId])
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELLED
  TRIALING
}

model SubscriptionUsage {
  id             String       @id @default(uuid())
  subscriptionId String
  featureKey     String       // e.g., "max_projects", "api_calls"
  quantityUsed   Int          @default(0)
  limit          Int          // Set from Plan quota
  resetAt        DateTime

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, featureKey])
  @@index([subscriptionId])
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  stripePriceId String         @unique
  price         Decimal        @db.Decimal(10, 2)
  interval      BillingInterval
  features      Json           // Store limits and feature flags
  isActive      Boolean        @default(true)

  subscriptions Subscription[]
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Invoice {
  id              String         @id @default(uuid())
  subscriptionId  String?
  organizationId  String
  invoiceNumber   String         @unique // Generates prefix (e.g., INV-2026-XXXX)
  amount          Decimal        @db.Decimal(10, 2)
  currency        String         @default("IDR")
  status          InvoiceStatus  @default(UNPAID)
  paymentUrl      String?        @db.Text
  providerInvoiceId String?      @unique // Xendit/Stripe Invoice ID
  paidAt          DateTime?
  dueAt           DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  subscription    Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@index([organizationId])
  @@index([providerInvoiceId])
  @@index([status])
}

enum InvoiceStatus {
  UNPAID
  PAID
  EXPIRED
  CANCELLED
}

// ==========================================
// 3. Content Management System (CMS)
// ==========================================

model Post {
  id          String     @id @default(uuid())
  workspaceId String
  authorId    String
  title       String
  slug        String
  content     String     @db.Text
  publishedAt DateTime?
  status      PostStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User       @relation(fields: [authorId], references: [id])
  comments    Comment[]
  tags        TagsOnPosts[]
  categories  CategoriesOnPosts[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([authorId])
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id        String              @id @default(uuid())
  name      String
  slug      String              @unique
  posts     CategoriesOnPosts[]
}

model CategoriesOnPosts {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
}

model Tag {
  id    String        @id @default(uuid())
  name  String
  slug  String        @unique
  posts TagsOnPosts[]
}

model TagsOnPosts {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorName String
  email     String
  content   String   @db.Text
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// ==========================================
// 4. Portfolio Showcase
// ==========================================

model Project {
  id          String          @id @default(uuid())
  workspaceId String
  title       String
  slug        String
  description String          @db.Text
  liveUrl     String?
  githubUrl   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stacks      ProjectStack[]
  media       ProjectMedia[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model ProjectStack {
  id        String   @id @default(uuid())
  projectId String
  name      String
  version   String?

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectMedia {
  id        String   @id @default(uuid())
  projectId String
  url       String
  alt       String?
  sortOrder Int      @default(0)

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ==========================================
// 5. Store / E-Commerce System
// ==========================================

model Product {
  id          String           @id @default(uuid())
  workspaceId String
  name        String
  slug        String
  description String           @db.Text
  basePrice   Decimal          @db.Decimal(10, 2)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model ProductVariant {
  id        String      @id @default(uuid())
  productId String
  sku       String      @unique
  name      String
  price     Decimal     @db.Decimal(10, 2)
  stock     Int         @default(0)

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  totalAmount Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]

  @@index([userId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

model OrderItem {
  id               String         @id @default(uuid())
  orderId          String
  productVariantId String
  quantity         Int
  price            Decimal        @db.Decimal(10, 2)

  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productVariantId])
}

model PaymentMethod {
  id             String            @id @default(uuid())
  userId         String
  provider       PaymentProvider   // "XENDIT" | "STRIPE" | "MIDTRANS"
  type           PaymentMethodType // "QRIS" | "VIRTUAL_ACCOUNT" | "E_WALLET" | "CREDIT_CARD"
  providerToken  String            // Token/ID from gateway for recurring charges
  metadata       Json?             // E-wallet phone number, VA number, etc.
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PaymentProvider {
  XENDIT
  STRIPE
  MIDTRANS
  PAYPAL
}

enum PaymentMethodType {
  QRIS
  VIRTUAL_ACCOUNT
  E_WALLET
  CREDIT_CARD
}

model Payment {
  id              String        @id @default(uuid())
  invoiceId       String
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("IDR")
  status          PaymentStatus @default(PENDING)
  provider        PaymentProvider
  providerTxId    String?       @unique // Xendit/Stripe transaction reference
  errorMessage    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([providerTxId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ==========================================
// 6. Observability & Logging System
// ==========================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // e.g., "USER_LOGIN", "PROJECT_CREATE"
  entityType String   // e.g., "Post", "Project"
  entityId   String?
  metadata   Json?    // Stores changes (before/after states)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model ApiLog {
  id             String   @id @default(uuid())
  method         String
  path           String
  statusCode     Int
  durationMs     Int
  ipAddress      String?
  organizationId String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

model WebhookLog {
  id             String       @id @default(uuid())
  provider       PaymentProvider
  eventId        String       @unique // Idempotency Key (Xendit Event ID / Stripe ID)
  eventType      String
  payload        Json
  status         WebhookStatus @default(RECEIVED)
  errorMessage   String?
  processedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@index([eventId])
  @@index([status])
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
}

// ==========================================
// 7. Core System Configuration
// ==========================================

model Setting {
  id          String    @id @default(uuid())
  workspaceId String
  key         String
  value       String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  isEnabled   Boolean  @default(false)
  rules       Json?    // Custom target conditions (e.g. beta users only)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String             @id @default(uuid())
  recipient String             // User ID or Email
  channel   NotificationChannel
  title     String
  body      String
  isRead    Boolean            @default(false)
  sentAt    DateTime?
  createdAt DateTime           @default(now())
}

enum NotificationChannel {
  EMAIL
  IN_APP
  WEBHOOK
}

model BillingEvent {
  id             String       @id @default(uuid())
  organizationId String
  type           String       // e.g., "METERED_INCREMENT", "PLAN_CHANGE"
  description    String
  amount         Decimal?     @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
}
